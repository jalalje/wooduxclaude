{
  "cleanUrls": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.woodux.online" }], "destination": "https://woodux.online/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "woodux.vercel.app" }], "destination": "https://woodux.online/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
      { "key": "Link", "value": "</assets/article-enhancements.css>; rel=stylesheet" }
    ] }
  ]
}
